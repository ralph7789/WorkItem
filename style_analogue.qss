/* Global Defaults */
QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 14px;
    color: #333333;
}

QMainWindow {
    background-color: #f7f9fc;
}

/* Toolbar */
QToolBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e0e4e8;
    padding: 8px;
    spacing: 12px;
}

/* Sidebars and Panels */
QSplitter::handle {
    background-color: #e0e4e8;
    width: 2px;
}

QListWidget, QListView {
    background-color: #ffffff;
    border: 1px solid #e0e4e8;
    border-radius: 6px;
    padding: 4px;
    outline: none;
}

QListWidget::item, QListView::item {
    padding: 10px;
    border-radius: 4px;
    margin-bottom: 2px;
}

QListWidget::item:hover, QListView::item:hover {
    background-color: #f0f4f8;
}

QListWidget::item:selected, QListView::item:selected {
    background-color: #e3f2fd;
    color: #0d47a1;
    font-weight: bold;
}

/* Detail View Panels */
QTextBrowser {
    background-color: #ffffff;
    border: 1px solid #e0e4e8;
    border-radius: 6px;
    padding: 12px;
    font-size: 14px;
    line-height: 1.5;
}

QTextEdit {
    background-color: #ffffff;
    border: 1px solid #e0e4e8;
    border-radius: 6px;
    padding: 10px;
    font-size: 14px;
}

QTextEdit:focus {
    border: 1px solid #2196f3;
}

/* Typography Headings */
QLabel {
    color: #2c3e50;
}

QLabel h2 {
    font-size: 20px;
    font-weight: 600;
    color: #1a202c;
    margin: 0;
}

/* Buttons */
QPushButton {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #f3f4f6;
    border: 1px solid #9ca3af;
}

QPushButton:pressed {
    background-color: #e5e7eb;
}

/* Primary Call to Action Buttons (e.g. Add WorkItem, Submit Note) */
QPushButton#primary_btn {
    background-color: #2563eb;
    color: white;
    border: none;
}

QPushButton#primary_btn:hover {
    background-color: #1d4ed8;
}

QPushButton#primary_btn:pressed {
    background-color: #1e40af;
}

QPushButton:disabled {
    background-color: #f3f4f6;
    color: #9ca3af;
    border: 1px solid #e5e7eb;
}

/* Theme Toggle Button */
QPushButton#theme_toggle_btn {
    background-color: #e2e8f0;
    color: #475569;
    border: none;
    border-radius: 16px;
    min-width: 32px;
    min-height: 32px;
    max-width: 32px;
    max-height: 32px;
    font-size: 16px;
    padding: 0;
}
QPushButton#theme_toggle_btn:hover {
    background-color: #cbd5e1;
    color: #1e293b;
}

QComboBox {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 6px 12px;
    min-width: 200px;
}
